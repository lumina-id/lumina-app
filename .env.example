# Azure OpenAI Configuration (for Suggestions)
AZURE_OPENAI_API_KEY="<your-azure-openai-api-key>"
AZURE_OPENAI_ENDPOINT="https://bayus-mjsyqo31-eastus2.cognitiveservices.azure.com/"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-5-nano"

# Azure Speech Service (TTS & STT) Configuration
# Option 1: Use regional endpoint (set AZURE_SPEECH_REGION)
# Option 2: Use Foundry endpoint (set AZURE_SPEECH_ENDPOINT)
AZURE_SPEECH_KEY="<your-speech-key>"
AZURE_SPEECH_REGION="southeastasia"
# AZURE_SPEECH_ENDPOINT="https://lumina-foundry.cognitiveservices.azure.com/"

# MySQL Database Configuration
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="lumina_db"

# Telegram Bot Configuration
# 1. Create a bot via @BotFather on Telegram
# 2. Get the token and paste it here
TELEGRAM_BOT_TOKEN="<your-telegram-bot-token>"

# Telegram Chat IDs for each contact
# To get chat ID: Send message to your bot, then visit:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_CHAT_ID_ANITA="<chat-id-for-first-contact>"
TELEGRAM_CHAT_ID_MOM="<chat-id-for-second-contact>"
TELEGRAM_CHAT_ID_NURSE="<chat-id-for-third-contact>"
